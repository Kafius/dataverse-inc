---
import { sanityClient } from 'sanity:client';
import { TEAM_QUERY } from '../sanity/lib/queries';
import { urlFor } from '../sanity/lib/image';

const team = await sanityClient.fetch(TEAM_QUERY);
---

<!-- TEAM -->
<section class="section bg-cream pt-0" id="team">
  <div class="section-inner">
    <div class="text-center mb-15">
      <span class="section-eyebrow">Our People</span>
      <h2 class="section-h2">Meet the Dataverse team</h2>
      <div class="divider center"></div>
      <p class="section-lead mx-auto mt-4">Our strength is our people. Every member of the Dataverse team brings specialized expertise, a collaborative spirit, and a shared commitment to excellence.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.map(member => (
        <div class="bg-white rounded-2xl overflow-hidden border border-black/7 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_50px_rgba(26,13,46,0.1)]">
          <div class="w-full aspect-square bg-gradient-to-br from-[#dce4ef] to-[#c5d2e4] relative overflow-hidden">
            {member.photo ? (
              <img
                src={urlFor(member.photo).width(600).height(600).fit('crop').auto('format').url()}
                alt={member.name}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="absolute inset-0 flex flex-col items-center justify-center text-5xl">
                👤
                <span class="absolute bottom-2.5 text-[0.65rem] tracking-[0.08em] uppercase text-navy/30">Photo Placeholder</span>
              </div>
            )}
          </div>
          <div class="px-5 py-4.5">
            <div class="font-bold text-[0.95rem] text-navy mb-0.5">{member.name}</div>
            <div class="text-[0.8rem] text-brand font-semibold mb-2">{member.role}</div>
            {member.bio && <div class="text-[0.8rem] text-muted leading-[1.55]">{member.bio}</div>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
