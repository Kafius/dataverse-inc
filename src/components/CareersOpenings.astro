---
import { sanityClient } from 'sanity:client';
import { JOB_OPENINGS_QUERY } from '../sanity/lib/queries';

const jobs = await sanityClient.fetch(JOB_OPENINGS_QUERY);
---

<!-- JOB OPENINGS -->
  <section class="section" id="openings">
    <div class="section-inner">
      <div class="mb-10">
        <span class="section-eyebrow">Open Positions</span>
        <h2 class="section-h2">Current openings</h2>
        <div class="divider"></div>
        <p class="section-lead">Don't see the right role? Send your resume to <a href="mailto:careers@dataverseinc.com" class="text-brand no-underline hover:underline">careers@dataverseinc.com</a> — we're always growing.</p>
      </div>
      <div class="flex flex-col gap-3">
        {jobs.map(job => (
          <div class="bg-white rounded-xl px-7 py-5.5 border border-black/8 flex justify-between items-center gap-6 transition-all duration-300 hover:border-brand hover:shadow-[0_6px_24px_rgba(139,92,246,0.08)] max-sm:flex-col max-sm:items-start">
            <div>
              <h4 class="text-[0.95rem] font-bold text-navy mb-2">{job.title}</h4>
              <div class="flex gap-2 flex-wrap">
                <span class="bg-brand/10 text-brand rounded-full px-3 py-1 text-[0.72rem] font-bold">{job.department}</span>
                <span class="bg-cream text-muted rounded-full px-3 py-1 text-[0.72rem] font-medium">{job.employmentType}</span>
                <span class="bg-cream text-muted rounded-full px-3 py-1 text-[0.72rem] font-medium">{job.location}</span>
              </div>
            </div>
            <a href={`/contact?inquiry=Career+Opportunities&job=${encodeURIComponent(job.title)}`} class="bg-navy text-white no-underline px-6 py-2.5 rounded-lg text-[0.84rem] font-bold transition-all shrink-0 hover:bg-brand hover:text-navy">Apply Now</a>
          </div>
        ))}
      </div>
    </div>
</section>
