---
import { sanityClient } from 'sanity:client';
import { COMMUNITY_EVENTS_QUERY } from '../sanity/lib/queries';
import { urlFor } from '../sanity/lib/image';

const initiatives = await sanityClient.fetch(COMMUNITY_EVENTS_QUERY);
---

<!-- INITIATIVES -->
  <section class="section">
    <div class="section-inner">
      <div class="grid grid-cols-1 gap-9 lg:grid-cols-2">
        {initiatives.map(item => (
          <div class="bg-white rounded-2xl overflow-hidden border border-black/8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(0,0,0,0.08)]">
            <div class="w-full aspect-video bg-linear-to-br from-[#dce4ef] to-[#c5d2e4] relative overflow-hidden">
              {item.photo ? (
                <img
                  src={urlFor(item.photo).width(1200).height(675).fit('crop').auto('format').url()}
                  alt={item.photo.alt || item.title}
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center flex-col gap-2">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-navy/30"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                  <span class="text-[0.65rem] tracking-[0.08em] uppercase text-navy/30">Photo Placeholder</span>
                </div>
              )}
            </div>
            <div class="px-8 py-7">
              <span class="inline-block bg-brand/10 text-brand text-[0.7rem] font-bold tracking-widest uppercase px-3 py-1 rounded-full mb-3">{item.tag}</span>
              <h3 class="font-serif text-[1.3rem] text-navy mb-2.5">{item.title}</h3>
              <p class="text-[0.875rem] text-charcoal leading-[1.65] mb-3">{item.description}</p>
              <p class="text-[0.82rem] text-muted leading-[1.6] italic">{item.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
