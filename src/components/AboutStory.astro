---
const values = [
  { icon: '🎯', title: 'Precision', body: 'Multi-layer QA ensures accuracy on every project, every time.' },
  { icon: '🤝', title: 'Partnership', body: 'We invest in your success as if it were our own.' },
  { icon: '🔒', title: 'Security', body: 'Your data is handled with the highest standards of confidentiality.' },
  { icon: '⚡', title: 'Agility', body: 'Scalable capacity to meet your needs as they evolve.' },
];

const milestones = [
  { year: '2022', title: 'Dataverse Founded', body: 'Launched as a boutique data entry and document processing firm serving local businesses.' },
  { year: '2023', title: 'Entertainment & Music Sector', body: 'Established specialized cue sheet processing services for the entertainment industry.' },
  { year: 'Today', title: 'Growing Stronger', body: 'A team serving clients across industries with precision and pride.' },
];
---

<!-- STORY -->
<section class="section">
  <div class="section-inner grid grid-cols-1 gap-12 items-start lg:grid-cols-2 lg:gap-20">
    <div>
      <span class="section-eyebrow">Our Story</span>
      <h2 class="section-h2">From humble beginnings<br>to industry leaders</h2>
      <div class="divider"></div>
      <p class="section-lead">Over the years, we've grown from a small data processing team into a full-service outsourcing company serving clients across healthcare, entertainment, finance, and beyond.</p>
      <p class="section-lead mt-4">Our team of dedicated specialists brings deep domain knowledge, rigorous quality controls, and a genuine commitment to your success. We don't just process your work — we become an extension of your team.</p>

      <div class="mt-10">
        {milestones.map(m => (
          <div class="flex gap-5 py-5.5 border-b border-black/7 last:border-b-0">
            <div class="font-serif text-2xl text-brand min-w-16 pt-0.5">{m.year}</div>
            <div>
              <h4 class="text-[0.95rem] font-bold text-navy mb-1">{m.title}</h4>
              <p class="text-[0.875rem] text-muted leading-[1.6]">{m.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="sticky top-22">
      <button
        type="button"
        id="videoTrigger"
        aria-label="Play the Dataverse orientation video, 3 minutes 38 seconds"
        class="group relative block w-full p-0 mb-5 border-0 bg-transparent cursor-pointer rounded-2xl overflow-hidden"
      >
        <img
          src="/videos/dataverse-orientation-poster.jpg"
          alt=""
          width="1280"
          height="720"
          class="block w-full aspect-video object-cover"
        />
        <span class="absolute inset-0 bg-navy/25 transition-colors group-hover:bg-navy/40"></span>
        <span class="absolute inset-0 flex items-center justify-center">
          <span class="flex items-center justify-center w-16 h-16 rounded-full bg-brand shadow-xl transition-transform group-hover:scale-110">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-6 h-6 text-navy ml-1">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
        </span>
        <span class="absolute bottom-3 right-3 px-2 py-1 rounded bg-navy/80 text-white text-[0.7rem] font-bold tracking-wide">3:38</span>
      </button>

      <div class="grid grid-cols-2 gap-3">
        {values.map(v => (
          <div class="bg-cream rounded-xl px-5 py-4.5 border border-black/6">
            <span class="text-2xl block mb-2">{v.icon}</span>
            <h4 class="text-[0.88rem] font-bold text-navy mb-1">{v.title}</h4>
            <p class="text-[0.8rem] text-muted leading-normal">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<dialog
  id="videoModal"
  aria-label="Dataverse orientation video"
  class="w-[92vw] max-w-[1100px] bg-transparent p-0 border-0 backdrop:bg-navy/85"
>
  <button
    type="button"
    id="videoClose"
    class="ml-auto mb-3 flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/10 text-white text-[0.8rem] font-medium tracking-wide cursor-pointer border border-white/20 transition-colors hover:bg-white/20"
  >
    Close
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="w-3.5 h-3.5">
      <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" />
    </svg>
  </button>

  <video
    id="orientationVideo"
    controls
    playsinline
    preload="none"
    poster="/videos/dataverse-orientation-poster.jpg"
    class="block w-full aspect-video rounded-xl bg-black"
  >
    <source src="/videos/dataverse-orientation.mp4" type="video/mp4" />
    Your browser does not support embedded video.
    <a href="/videos/dataverse-orientation.mp4">Download the orientation video</a> instead.
  </video>
</dialog>

<script>
  const trigger = document.getElementById('videoTrigger');
  const modal = document.getElementById('videoModal') as HTMLDialogElement | null;
  const video = document.getElementById('orientationVideo') as HTMLVideoElement | null;
  const closeBtn = document.getElementById('videoClose');

  trigger?.addEventListener('click', () => {
    modal?.showModal();
    video?.play();
  });

  closeBtn?.addEventListener('click', () => modal?.close());

  // Backdrop click — the dialog element itself only paints the area outside the content.
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  // Fires for the close button, backdrop, and Esc alike.
  modal?.addEventListener('close', () => {
    if (video) {
      video.pause();
      video.currentTime = 0;
    }
  });
</script>
